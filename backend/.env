# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-dev
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Runtime: RLS-restricted app_user (SEC-03). Admin/ops & migrations use
# DATABASE_ADMIN_URL (amateo_owner = superuser, bypasses RLS — the
# superadmin supervision door; psql or `dbal:run-sql --connection admin`).
DATABASE_URL="postgresql://app_user:app_user_password@postgres:5432/amateo_dev?serverVersion=16&charset=utf8"
DATABASE_ADMIN_URL="postgresql://amateo_owner:clubscheduler_dev_password@postgres:5432/amateo_dev?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=clubscheduler_dev_jwt_passphrase
# SEC-16 (audit) — `JWT_COOKIE_SECURE` n'est VOLONTAIREMENT pas défini ici.
# Ce fichier entre dans l'image de prod (.dockerignore l'y garde) et sa valeur
# gagnerait sur le défaut fail-closed de services.yaml : un `false` posé ici
# partirait en production et le cookie de session voyagerait sans `Secure`.
# Le `false` de dev vit dans .env.dev, celui des tests dans .env.test — deux
# fichiers exclus de l'image ET chargés seulement pour leur APP_ENV. La prod
# prend le `true` de .env.prod (et, à défaut, celui de services.yaml).
# Gardé par SEC-16 : JwtCookieSecureDefaultTest.
###< lexik/jwt-authentication-bundle ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
REDIS_URL=redis://redis:6379/0

MERCURE_URL=http://mercure/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
# Fallback for non-Docker runs; under Docker, compose overrides this with the
# actual ${MERCURE_PORT} so the browser URL always matches the published port.
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# Dedicated Mercure hub secret — distinct from JWT_PASSPHRASE (SEC-06).
MERCURE_JWT_SECRET=clubscheduler_dev_mercure_hs256_secret_change_me
###< symfony/mercure-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
# Failed messages (retries exhausted) are preserved here instead of dropped.
# SEC-16 (2026-08-07) — stream DÉDIÉ, jamais celui des messages vifs. L'ancien DSN
# (redis://redis:6379/messages/failed) posait le groupe `failed` sur le MÊME stream
# `messages` : dès que ce groupe était matérialisé (un `messenger:setup-transports`,
# ou le premier message réellement routé en échec), TOUT dispatch rendait 500 — le
# transport redis refuse `delete_after_ack` quand plus d'un groupe lit le stream.
# Reproduit en dev le 2026-08-07. Au déploiement : vérifier qu'aucun `.env.prod` ne
# ré-écrase ce DSN avec l'ancien, et détruire le groupe hérité s'il existe
# (`XGROUP DESTROY messages failed` — après `messenger:failed:show` vide).
MESSENGER_FAILURE_TRANSPORT_DSN=redis://redis:6379/failed_messages/failed
###< symfony/messenger ###

###> symfony/mailer ###
# Dev: capture all mail in Mailpit (web UI on MAILPIT_WEB_PORT). Tests override to null://null.
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

# Absolute base URL of the frontend, used to build cockpit links in cron emails
# (a CLI has no Request). Empty → emails omit the link line. Set per environment.
FRONTEND_BASE_URL=http://localhost:5173

# Destination address for the member-feedback digest (P5-6). Empty by default —
# this file ships in the prod image, so a safe default is the empty string; the
# real support mailbox is set per environment. Not consulted by the feedback
# submission endpoint (which only stores + acknowledges); it names where the
# periodic digest is delivered.
SUPPORT_EMAIL=

# Sender of every outgoing email (P5-15). Must sit on a domain VERIFIED at the
# transactional provider (SPF/DKIM/DMARC in place) — anything else lands in spam.
# `no-reply@` is not a mailbox: nobody reads replies, it is DNS + a sending service.
MAIL_FROM_ADDRESS=no-reply@amateo.app
MAIL_FROM_NAME=Amateo

# Product identity read by humans (P5-15) — commercial name + publisher (the RGPD
# data controller). Variables so a future rename is one change, never a literal
# hunt across email subjects, screen labels and the TOTP URI. Non-secret.
APP_PRODUCT_NAME=Amateo
APP_PUBLISHER_NAME=Maratech

###> sentry/sentry-symfony ###
# Vide = SDK inactif. Poser le DSN du projet Sentry pour activer (INF-01).
SENTRY_DSN=
###< sentry/sentry-symfony ###
