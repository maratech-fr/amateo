<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
          bootstrap="tests/bootstrap.php"
          colors="true"
 >
    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
        <!-- Après DAMA : relâche la transaction du parent avant une classe de tests isolés
             (#[RunInSeparateProcess]) — sinon l'enfant attend les verrous du parent. -->
        <bootstrap class="App\Tests\ReleasesParentTransactionBeforeIsolatedTests"/>
    </extensions>
    <!-- Rangement PAR NATURE (pas par nom de dossier) : un dossier qui contient au moins un test
         conteneur (KernelTestCase/WebTestCase) va dans `Integration` ; un dossier 100 % `TestCase`
         pur va dans `Unit`. Chaque sous-dossier de `tests/` doit figurer dans exactement UNE
         testsuite, sinon une invocation par testsuite (et `make test`) le saute en silence. Gardé
         par `Unit/TestsuitesCoverEveryTestDirectoryTest` (P4-169). -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>tests/Logging</directory>
            <directory>tests/Messenger</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
            <directory>tests/Security</directory>
            <directory>tests/Queue</directory>
            <directory>tests/Api</directory>
            <directory>tests/Command</directory>
            <directory>tests/OpenApi</directory>
            <directory>tests/Validator</directory>
            <directory>tests/MessageHandler</directory>
            <directory>tests/EventListener</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory>tests/CrossStack</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="KERNEL_CLASS" value="App\Kernel" />
        <server name="APP_ENV" value="test" />
        <server name="SYMFONY_DEPRECATIONS_HELPER" value="weak" />
    </php>
    <!-- Périmètre de couverture (P4-166, décision B4) : le code applicatif `src`,
         exclusions DÉCLARÉES (jamais implicites). PHPUnit 11 n'a pas de seuil natif
         (option « fail-under » absente) : le cliquet vit dans scripts/coverage-gate.php,
         lu de coverage-floor.json. Les migrations sont hors `src` (backend/migrations/)
         donc déjà exclues sans avoir à les lister ici. -->
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <file>src/Kernel.php</file>
            <directory>src/Seed</directory>
            <directory>src/DataFixtures</directory>
        </exclude>
    </source>
</phpunit>
