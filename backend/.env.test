###> symfony/framework-bundle ###
APP_SECRET=test-insecure-not-a-real-secret-do-not-use-in-prod
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://amateo_app:app_user_password@postgres:5432/amateo_test?serverVersion=16&charset=utf8"
DATABASE_ADMIN_URL="postgresql://amateo_owner:clubscheduler_dev_password@postgres:5432/amateo_test?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Discard all mail in tests (no real SMTP side effects).
MAILER_DSN=null://null
FRONTEND_BASE_URL=http://localhost:5173
###< symfony/mailer ###

###> SEC-16 (audit) ###
# Cookie du JWT sans `Secure` — le harnais ne parle jamais en TLS, et un cookie Secure n'y serait pas stocké
# (l'e2e dockerisé tape http://frontend-dev:5173). Ce fichier n'entre PAS dans
# l'image de prod et n'est chargé que pour cet APP_ENV : le réglage ne peut pas
# fuir en production. Détail : docs/security/jwt-cookie.md
JWT_COOKIE_SECURE=false
###< SEC-16 (audit) ###

###> horloge simulée ###
# Tests : drapeau OFF par défaut (un test dédié construit ClubClock avec le drapeau posé).
APP_CLUB_CLOCK_ALL=0
###< horloge simulée ###

###> vérification FFBB à l'inscription ###
# Tests : OFF par défaut — les suites d'inscription créent des clubs sur des codes
# SYNTHÉTIQUES que le stub FFBB ignore. Un test dédié pose la variable à true avant
# le boot (patron RegisterTurnstileTest) et s'inscrit avec le code connu du stub.
FFBB_REGISTER_EXISTENCE_CHECK=false
###< vérification FFBB à l'inscription ###

###> mise en prod programmée ###
# Tests : vides par défaut — le client GitHub roule sur un double HTTP (aucun appel réseau).
# Les suites concernées posent le jeton/dépôt avant le boot (patron RegisterTurnstileTest).
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPOSITORY=
###< mise en prod programmée ###

###> mesure d'audience Umami ###
# Tests : vides par défaut — le client Umami roule sur un double HTTP (aucun appel réseau).
# Les suites concernées posent la clé/le site avant le boot (patron RegisterTurnstileTest).
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=
###< mesure d'audience Umami ###
