# Clés à poser dans /opt/actions-runner-N/.env de CHAQUE runner (N = 1, 2, 3), puis
# relancer le service (`sudo ./svc.sh stop && sudo ./svc.sh start`).
# Procédure : docs/ops/ci-runner.md. Aucun secret ici.
#
# Hooks de nettoyage (copiés depuis .github/runner/, root, 755).
ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/amateo-ci/hooks/job-started.sh
ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/opt/amateo-ci/hooks/job-completed.sh
# Identifiants Docker propres au runner (chaque job les redirige encore vers $RUNNER_TEMP).
DOCKER_CONFIG=/opt/actions-runner-N/.docker
# HOME propre au runner (dossier créé, chown runner:runner).
HOME=/opt/actions-runner-N/home
