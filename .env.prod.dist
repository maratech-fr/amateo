# ============================================================================
# ClubScheduler — PROD environment template
# ============================================================================
# Copy to `.env.prod` NEXT TO docker-compose.prod.yml on the VM, fill every
# CHANGEME, then:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# This single file feeds BOTH compose interpolation (${...} in the yml) and
# the containers' runtime env (env_file on the php services). It holds real
# secrets on the VM → never commit a filled copy, keep it chmod 600.
# The filled file IS versioned, encrypted: `make env-encode@prod` writes the
# committed .env.prod.gpg (`make env-decode@prod` for the reverse), and the
# deploy job decodes it onto the VM. This template stays the readable list of
# every variable — add new variables here (CHANGEME) AND in the encrypted rail.
# Step-by-step first-install guide: docs/ops/deploy.md
# ============================================================================

# --- Deploy ------------------------------------------------------------------
# ghcr.io namespace (lowercase GitHub owner) + image tag to run.
GHCR_OWNER=franckmb
VERSION=latest

# Public origin of the app (scheme + domain, no trailing slash). Drives the
# Mercure CORS allowlist, MERCURE_PUBLIC_URL and the emails' links.
# ⚠ NO ${VAR} self-references anywhere in this file: compose only interpolates
# inside env_file from v2.24 — on older binaries the literal string would reach
# the containers. Repeat values by hand and keep them in sync.
PUBLIC_BASE_URL=https://CHANGEME.example.com
# Same value as PUBLIC_BASE_URL:
FRONTEND_BASE_URL=https://CHANGEME.example.com

# Only published port (localhost) — the host reverse-proxy (Caddy) targets it.
FRONTEND_PORT=8081

# --- Symfony core --------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0
# Fresh 32+ char random value — NEVER the dev one. e.g.: openssl rand -hex 32
APP_SECRET=CHANGEME

# --- Database ------------------------------------------------------------------
POSTGRES_DB=amateo
POSTGRES_USER=amateo_owner
# e.g.: openssl rand -hex 24 (also used inside the two DSNs below)
POSTGRES_PASSWORD=CHANGEME
# Runtime DSN = amateo_app (RLS-enforced role; password set by the init script
# 02-users.sh from these vars, first cluster init only) — NEVER the superuser
# in DATABASE_URL.
APP_USER_PASSWORD=CHANGEME
# Full DSNs, values REPEATED by hand (no ${} — see the interpolation warning
# above): amateo_app password = APP_USER_PASSWORD, admin password = POSTGRES_PASSWORD,
# db name = POSTGRES_DB.
DATABASE_URL="postgresql://amateo_app:CHANGEME@postgres:5432/amateo?serverVersion=16&charset=utf8"
# Admin DSN (migrations/ops only — bypasses RLS).
DATABASE_ADMIN_URL="postgresql://amateo_owner:CHANGEME@postgres:5432/amateo?serverVersion=16&charset=utf8"

# --- Auth ----------------------------------------------------------------------
# Fresh passphrase; generate the prod keypair with it in ./jwt next to the
# compose file. ⚠ The php containers run as uid 1000 and mount ./jwt read-only:
# the key files MUST be readable by uid 1000 or EVERY login 500s while the
# stack looks healthy. Generate + fix ownership in one go:
#   mkdir -p jwt
#   openssl genpkey -algorithm RSA -aes256 -pass pass:<JWT_PASSPHRASE> -pkeyopt rsa_keygen_bits:4096 -out jwt/private.pem
#   openssl pkey -in jwt/private.pem -passin pass:<JWT_PASSPHRASE> -pubout -out jwt/public.pem
#   chown -R 1000:1000 jwt && chmod 600 jwt/private.pem && chmod 644 jwt/public.pem
JWT_PASSPHRASE=CHANGEME
# SEC-16 (audit) — le JWT applicatif voyage en cookie httpOnly. `true` EXIGÉ en
# production (TLS). Laisser cette ligne telle quelle, ou la supprimer : le
# backend/.env.prod committé et le défaut du conteneur valent déjà `true`. Ce
# qu'il ne faut JAMAIS faire, c'est y recopier le `false` d'un .env de dev — une
# vraie variable d'environnement gagne sur tous les fichiers.
# Détail : docs/security/jwt-cookie.md
JWT_COOKIE_SECURE=true
CORS_ALLOW_ORIGIN='^https://CHANGEME\.example\.com$'

# --- Mercure -------------------------------------------------------------------
# e.g.: openssl rand -hex 32
MERCURE_JWT_SECRET=CHANGEME

# --- Mailer --------------------------------------------------------------------
# Real SMTP transport (Scaleway TEM / Brevo / Mailgun...). NO mailpit in prod.
MAILER_DSN=smtp://CHANGEME
# Sender of every outgoing email. It MUST sit on the domain verified at the
# provider (SPF/DKIM/DMARC posed for that exact domain) — a `from` outside the
# verified domain is spam-foldered or refused outright. Defaults live in
# backend/config/services.yaml; set them here when the sending domain differs.
MAIL_FROM_ADDRESS=no-reply@amateo.app
MAIL_FROM_NAME=Amateo

# --- Observability (empty = disabled, never crashes the app) --------------------
SENTRY_DSN=
ENGINE_SENTRY_DSN=

# --- Backups off-site (recommended) ----------------------------------------------
# Executed by app:db:backup after each dump; failure = warning, never blocking.
# Scaleway Object Storage example (S3-compatible), credentials via RCLONE_* env:
#   BACKUP_SYNC_COMMAND=rclone copyto /app/backend/var/backups :s3:clubscheduler-backups/db --s3-provider=Scaleway --s3-endpoint=s3.fr-par.scw.cloud --s3-region=fr-par
#   RCLONE_S3_ACCESS_KEY_ID=CHANGEME
#   RCLONE_S3_SECRET_ACCESS_KEY=CHANGEME
# Full walkthrough: docs/ops/backup-restore.md §Off-site.
BACKUP_SYNC_COMMAND=
