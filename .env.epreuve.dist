# Stack d'épreuve : copiée en .env du worktree par `make epreuve-up`, ports à côté de ceux du fondateur.
COMPOSE_PROJECT_NAME=amateo-epreuve
AMATEO_STACK=amateo-epreuve
VITE_PORT=5273

APP_ENV=dev
APP_DEBUG=1

FRONTEND_PORT=8181

NGINX_PORT=8180
ENGINE_PORT=8100
POSTGRES_PORT=15432
REDIS_PORT=16379
MERCURE_PORT=13100
MAILPIT_SMTP_PORT=11025
MAILPIT_WEB_PORT=18025

POSTGRES_DB=amateo_dev
POSTGRES_USER=amateo_owner
POSTGRES_PASSWORD=clubscheduler_dev_password
JWT_PASSPHRASE=clubscheduler_dev_jwt_passphrase
# Dedicated Mercure hub secret (HS256, distinct from the lexik JWT passphrase).
# Prod: replace with a random 32+ byte secret.
MERCURE_JWT_SECRET=clubscheduler_dev_mercure_hs256_secret_change_me
# Mercure 1.0 trusted issuer (RFC 9068 `iss`) — bound to the hub's signing keys AND posted
# by the backend on every token: the SAME value hub-side and backend-side (one source).
MERCURE_TRUSTED_ISSUERS=http://localhost

###> sentry engine ###
# Vide = SDK inactif (activation : docs/ops/backup-restore.md §5).
ENGINE_SENTRY_DSN=
###< sentry engine ###

###> backups ###
# Optionnel : commande shell off-site exécutée après chaque dump (ex. rclone copy
# /app/backend/var/backups b2:clubscheduler-backups). Vide = pas de sync.
BACKUP_SYNC_COMMAND=
###< backups ###
