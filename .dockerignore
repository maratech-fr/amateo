.git
.ai
.claude
frontend/node_modules
frontend/dist
frontend/storybook-static
engine/.venv
**/__pycache__

# Committed backend/.env + backend/.env.prod (safe defaults, no secrets) MUST
# reach the prod image — Symfony Dotenv layers them under real env vars.
# Everything below must NEVER enter an image:
backend/.env.local
backend/.env.*.local
backend/.env.dev
backend/.env.dist
backend/.env.test
backend/config/jwt
# Real demo identities override (local-only, gitignored) — must NEVER reach an
# image: COPY backend/ would otherwise bake the real coach names into the build.
backend/config/seed/bccl.identities.local.json
backend/var
backend/vendor
# assets:install output — regenerated INSIDE the prod build; excluding it keeps
# local builds identical to clean-checkout CI builds (no working-tree leftovers
# masking a broken assets step).
backend/public/bundles
backend/public/exports
